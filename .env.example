# e:/WORK/Used_clothing_fe/.env.example
# Backend API Base Endpoint Url
VITE_API_BASE_URL=https://api.usedclothingstore.com/api
# Trên Vercel, đặt biến này thành URL HTTPS của Azure API và giữ hậu tố /api.

# Supabase Storage
VITE_SUPABASE_URL=tbd
VITE_SUPABASE_ANON_KEY=tbd
VITE_SUPABASE_BUCKET=tbd

# Geoapify (maps, autocomplete, geocoding and routing)
VITE_GEOAPIFY_API_KEY=

# App Port (Optional)
PORT=3000
